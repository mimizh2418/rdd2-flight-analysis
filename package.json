{
  "name": "rdd2-flight-analysis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node tools/test.mjs",
    "test:browser": "playwright test",
    "test:python": "uv run --locked python -m unittest discover -s tests -p 'test_*.py'",
    "benchmark": "node tools/benchmark.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "service": "uv run --locked --extra simulation python tools/simulation_service.py"
  },
  "dependencies": {
    "apache-arrow": "21.2.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "0.180.0",
    "uplot": "1.6.32"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@types/three": "0.180.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
